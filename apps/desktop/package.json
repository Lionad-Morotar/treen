{
  "name": "@treen/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Treen 桌面外壳（Electron）",
  "main": "./out/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "smoke:app": "vite build && node test/e2e/app-boot-smoke.mjs",
    "smoke:freeze": "vite build --config vite.config.smoke.ts && electron out/freeze-smoke.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@treen/ipc": "workspace:*",
    "@treen/shared": "workspace:*"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "vite": "^8.3.4"
  }
}
