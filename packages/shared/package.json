{
  "name": "@treen/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "共享层：环境读取、日志脱敏与 OCR / 翻译的纯逻辑",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./text-metrics": {
      "types": "./src/text-metrics.ts",
      "default": "./src/text-metrics.ts"
    },
    "./translation": {
      "types": "./src/translation/index.ts",
      "default": "./src/translation/index.ts"
    },
    "./geometry": {
      "types": "./src/geometry.ts",
      "default": "./src/geometry.ts"
    },
    "./render": {
      "types": "./src/render.ts",
      "default": "./src/render.ts"
    },
    "./mermaid": {
      "types": "./src/mermaid/index.ts",
      "default": "./src/mermaid/index.ts"
    },
    "./overlay": {
      "types": "./src/overlay/index.ts",
      "default": "./src/overlay/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "mac-ocr": "^1.1.1"
  }
